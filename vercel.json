{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/companies",
      "permanent": true
    },
    {
      "source": "/landing",
      "destination": "/home",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/insights/:company",
      "destination": "/insights/_dynamic"
    },
    {
      "source": "/companies/in/:countrySlug",
      "destination": "/companies/in/_dynamic"
    }
  ]
}
